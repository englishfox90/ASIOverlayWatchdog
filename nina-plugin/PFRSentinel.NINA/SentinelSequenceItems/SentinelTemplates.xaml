<ResourceDictionary
    x:Class="PFRSentinel.NINA.SentinelSequenceItems.SentinelTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PFRSentinel.NINA.SentinelSequenceItems"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!-- Start Sentinel Capture - aperture + play.
         Aperture = the PFR Sentinel mark (same paths as the dockable icon, from
         assets/Icon.svg), with the action badge sitting in a gap cut out of it.

         The cut is CombinedGeometry/Exclude, NOT a fill rule. An EvenOdd
         knockout looks right only where the circle overlaps the aperture: over
         bare background the circle is covered once, so it fills solid, and the
         glyph inside it then lands on an even count and punches through as a
         hole - an inverted badge on a disc. Exclude subtracts strictly where
         the shapes intersect, which is what "leave a gap" actually means. -->
    <GeometryGroup x:Key="PFRSentinel_StartSVG" FillRule="Nonzero">
        <CombinedGeometry GeometryCombineMode="Exclude">
            <CombinedGeometry.Geometry1>
                <GeometryGroup FillRule="Nonzero">
                    <GeometryGroup.Transform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.30159" ScaleY="1.30159" />
                            <TranslateTransform X="-256.41" Y="-256.41" />
                        </TransformGroup>
                    </GeometryGroup.Transform>
                        <PathGeometry Figures="M449.46,383.68h90.44l-102.61-177.73c-55.56,13.45-106.53,41.91-147.98,83.36-27.7,27.7-49.59,59.65-65.09,94.37h225.25Z" />
                        <PathGeometry Figures="M591.87,393.69l45.21,78.31,102.56-177.63c-1.63-1.7-3.27-3.39-4.94-5.06-59.48-59.48-138.57-92.24-222.7-92.24-10.99,0-21.9.57-32.68,1.68l112.55,194.94s0,.01,0,.02Z" />
                        <PathGeometry Figures="M257.04,696.96l112.56-194.96,45.22-78.32h-205.25c-8.23,28.33-12.51,58-12.51,88.32,0,67.38,21.04,131.53,59.98,184.96Z" />
                        <PathGeometry Figures="M432.15,630.34s0,0,0-.01l-45.22-78.32-102.56,177.63c1.63,1.7,3.27,3.39,4.94,5.06,59.48,59.48,138.57,92.24,222.7,92.24,10.99,0,21.9-.57,32.69-1.68l-112.54-194.92Z" />
                        <PathGeometry Figures="M766.96,327.04l-112.56,194.96-45.22,78.32h205.25c8.23-28.33,12.51-58,12.51-88.32,0-67.38-21.04-131.53-59.98-184.96Z" />
                        <PathGeometry Figures="M574.57,640.32s-.02,0-.03,0h-90.44l102.61,177.73c55.56-13.46,106.53-41.91,147.98-83.36,27.7-27.7,49.59-59.65,65.09-94.37h-225.22Z" />
                        <EllipseGeometry Center="512,512" RadiusX="59.16" RadiusY="59.16" />
                </GeometryGroup>
            </CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2>
                <EllipseGeometry Center="757,757" RadiusX="272" RadiusY="272" />
            </CombinedGeometry.Geometry2>
        </CombinedGeometry>
        <PathGeometry Figures="M 655,600 L 655,914 L 940,757 Z" />
    </GeometryGroup>

    <!-- Stop Sentinel Capture - aperture + stop.
         Aperture = the PFR Sentinel mark (same paths as the dockable icon, from
         assets/Icon.svg), with the action badge sitting in a gap cut out of it.

         The cut is CombinedGeometry/Exclude, NOT a fill rule. An EvenOdd
         knockout looks right only where the circle overlaps the aperture: over
         bare background the circle is covered once, so it fills solid, and the
         glyph inside it then lands on an even count and punches through as a
         hole - an inverted badge on a disc. Exclude subtracts strictly where
         the shapes intersect, which is what "leave a gap" actually means. -->
    <GeometryGroup x:Key="PFRSentinel_StopSVG" FillRule="Nonzero">
        <CombinedGeometry GeometryCombineMode="Exclude">
            <CombinedGeometry.Geometry1>
                <GeometryGroup FillRule="Nonzero">
                    <GeometryGroup.Transform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.30159" ScaleY="1.30159" />
                            <TranslateTransform X="-256.41" Y="-256.41" />
                        </TransformGroup>
                    </GeometryGroup.Transform>
                        <PathGeometry Figures="M449.46,383.68h90.44l-102.61-177.73c-55.56,13.45-106.53,41.91-147.98,83.36-27.7,27.7-49.59,59.65-65.09,94.37h225.25Z" />
                        <PathGeometry Figures="M591.87,393.69l45.21,78.31,102.56-177.63c-1.63-1.7-3.27-3.39-4.94-5.06-59.48-59.48-138.57-92.24-222.7-92.24-10.99,0-21.9.57-32.68,1.68l112.55,194.94s0,.01,0,.02Z" />
                        <PathGeometry Figures="M257.04,696.96l112.56-194.96,45.22-78.32h-205.25c-8.23,28.33-12.51,58-12.51,88.32,0,67.38,21.04,131.53,59.98,184.96Z" />
                        <PathGeometry Figures="M432.15,630.34s0,0,0-.01l-45.22-78.32-102.56,177.63c1.63,1.7,3.27,3.39,4.94,5.06,59.48,59.48,138.57,92.24,222.7,92.24,10.99,0,21.9-.57,32.69-1.68l-112.54-194.92Z" />
                        <PathGeometry Figures="M766.96,327.04l-112.56,194.96-45.22,78.32h205.25c8.23-28.33,12.51-58,12.51-88.32,0-67.38-21.04-131.53-59.98-184.96Z" />
                        <PathGeometry Figures="M574.57,640.32s-.02,0-.03,0h-90.44l102.61,177.73c55.56-13.46,106.53-41.91,147.98-83.36,27.7-27.7,49.59-59.65,65.09-94.37h-225.22Z" />
                        <EllipseGeometry Center="512,512" RadiusX="59.16" RadiusY="59.16" />
                </GeometryGroup>
            </CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2>
                <EllipseGeometry Center="757,757" RadiusX="272" RadiusY="272" />
            </CombinedGeometry.Geometry2>
        </CombinedGeometry>
        <RectangleGeometry Rect="607,607,300,300" RadiusX="42" RadiusY="42" />
    </GeometryGroup>

    <!--
        The editable body of an instruction, shared by both. A DataTemplate cannot be
        inherited, but its content can: each DataTemplate below is a two-line shim
        around this one control template.
    -->
    <ControlTemplate x:Key="PFRSentinel_TimeoutEditor">
        <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Wait up to (s)" />
            <TextBox
                MinWidth="40"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding TimeoutSeconds}"
                TextAlignment="Right"
                ToolTip="How long Sentinel waits for capture to reach the target state before reporting a timeout. 1-300 seconds." />
        </StackPanel>
    </ControlTemplate>

    <ControlTemplate x:Key="PFRSentinel_TimeoutMini">
        <TextBlock
            MinWidth="40"
            Margin="5,0,0,0"
            VerticalAlignment="Center"
            Text="{Binding TimeoutSeconds}"
            TextAlignment="Right" />
    </ControlTemplate>

    <!--  Detail views. DataType must be the instruction type.  -->
    <DataTemplate DataType="{x:Type local:StartSentinelCapture}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <Control Template="{StaticResource PFRSentinel_TimeoutEditor}" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:StopSentinelCapture}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <Control Template="{StaticResource PFRSentinel_TimeoutEditor}" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <!--  Mini views on the imaging tab. Key MUST be the full type name + "_Mini".  -->
    <DataTemplate x:Key="PFRSentinel.NINA.SentinelSequenceItems.StartSentinelCapture_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <Control Template="{StaticResource PFRSentinel_TimeoutMini}" />
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>

    <DataTemplate x:Key="PFRSentinel.NINA.SentinelSequenceItems.StopSentinelCapture_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <Control Template="{StaticResource PFRSentinel_TimeoutMini}" />
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>
</ResourceDictionary>
