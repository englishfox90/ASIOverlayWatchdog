<ResourceDictionary
    x:Class="PFRSentinel.NINA.SentinelSequenceItems.SentinelTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PFRSentinel.NINA.SentinelSequenceItems"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!--
        Instruction icon. Renamed from the template's "Plugin_Test_SVG": NINA merges every
        plugin's dictionaries, so the template's key collides across every plugin built
        from it. Referenced by [ExportMetadata("Icon", ...)] on both instructions.
    -->
    <GeometryGroup x:Key="PFRSentinel_SVG">
        <PathGeometry Figures="M 153.646,20.8542L 88.875,20.8542L 88.875,180.708L 64.7708,180.708L 64.7708,20.8542L -1.01725e-005,20.8542L -1.01725e-005,-0.5625L 153.646,-0.5625L 153.646,20.8542 Z " />
        <PathGeometry Figures="M 263.627,115.083L 163.44,115.083C 163.44,123.458 164.69,130.729 167.211,136.938C 169.711,143.146 173.169,148.25 177.544,152.229C 181.752,156.125 186.773,159.042 192.586,161C 198.377,162.958 204.773,163.917 211.773,163.917C 221.023,163.917 230.336,162.083 239.711,158.375C 249.086,154.688 255.752,151.063 259.732,147.479L 260.94,147.479L 260.94,172.438C 253.232,175.688 245.357,178.396 237.315,180.583C 229.273,182.771 220.836,183.875 212.002,183.875C 189.44,183.875 171.836,177.771 159.169,165.563C 146.502,153.354 140.169,136 140.169,113.5C 140.169,91.2708 146.232,73.625 158.377,60.5417C 170.502,47.4792 186.482,40.9375 206.294,40.9375C 224.627,40.9375 238.752,46.3125 248.711,57.0208C 258.648,67.7292 263.627,82.9583 263.627,102.667L 263.627,115.083 Z " />
    </GeometryGroup>

    <!--
        The editable body of an instruction, shared by both. A DataTemplate cannot be
        inherited, but its content can: each DataTemplate below is a two-line shim
        around this one control template.
    -->
    <ControlTemplate x:Key="PFRSentinel_TimeoutEditor">
        <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Wait up to (s)" />
            <TextBox
                MinWidth="40"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding TimeoutSeconds}"
                TextAlignment="Right"
                ToolTip="How long Sentinel waits for capture to reach the target state before reporting a timeout. 1-300 seconds." />
        </StackPanel>
    </ControlTemplate>

    <ControlTemplate x:Key="PFRSentinel_TimeoutMini">
        <TextBlock
            MinWidth="40"
            Margin="5,0,0,0"
            VerticalAlignment="Center"
            Text="{Binding TimeoutSeconds}"
            TextAlignment="Right" />
    </ControlTemplate>

    <!--  Detail views. DataType must be the instruction type.  -->
    <DataTemplate DataType="{x:Type local:StartSentinelCapture}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <Control Template="{StaticResource PFRSentinel_TimeoutEditor}" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:StopSentinelCapture}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <Control Template="{StaticResource PFRSentinel_TimeoutEditor}" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <!--  Mini views on the imaging tab. Key MUST be the full type name + "_Mini".  -->
    <DataTemplate x:Key="PFRSentinel.NINA.SentinelSequenceItems.StartSentinelCapture_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <Control Template="{StaticResource PFRSentinel_TimeoutMini}" />
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>

    <DataTemplate x:Key="PFRSentinel.NINA.SentinelSequenceItems.StopSentinelCapture_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <Control Template="{StaticResource PFRSentinel_TimeoutMini}" />
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>
</ResourceDictionary>
